# HaloPSA MCP Server Configuration

# --- Required ---

# HaloPSA instance URL (e.g., https://psa.dtctoday.com)
HMCP_HALO_URL=

# HaloPSA OAuth Application credentials (for the MCP server's relay)
# Create an Application in HaloPSA with "Authorization Code" auth method
HMCP_HALO_CLIENT_ID=
HMCP_HALO_CLIENT_SECRET=

# HaloPSA tenant (hosted instances only, leave empty for on-premise)
HMCP_HALO_TENANT=

# Encryption key for token storage (32+ characters, AES-256-GCM)
HMCP_ENCRYPTION_KEY=

# --- Server ---

HMCP_HOST=0.0.0.0
HMCP_PORT=8080

# Public domain for OAuth redirects and link generation
HMCP_PUBLIC_DOMAIN=

# --- Database (Postgres + pgvector) ---

# Full connection URL. In compose this is provided automatically from the
# variables below; override only if you're pointing at an external Postgres.
# HMCP_DATABASE_URL=postgres://hmcp:hmcp@postgres:5432/hmcp

# Used by docker-compose to provision the postgres service and build the URL.
HMCP_DB_USER=hmcp
HMCP_DB_PASSWORD=hmcp
HMCP_DB_NAME=hmcp

# --- Semantic Search (optional) ---

HMCP_SEMANTIC_SEARCH=false
HMCP_EMBEDDER_URL=http://hmcp-embedder:8081

# HaloPSA service account for embedding (Client Credentials flow)
# Needs broad read access to index all tickets
HMCP_EMBED_CLIENT_ID=
HMCP_EMBED_CLIENT_SECRET=
HMCP_EMBED_TENANT=

# Webhook secret for HaloPSA event notifications
HMCP_WEBHOOK_SECRET=

# --- Embedder ---

# Provider: "local" (fastembed), "openai", or "ollama"
HMCP_EMBED_PROVIDER=local
HMCP_EMBED_MODEL=BAAI/bge-base-en-v1.5

# OpenAI provider
# HMCP_EMBED_API_KEY=
# HMCP_EMBED_API_URL=https://api.openai.com/v1/embeddings

# Ollama provider
# HMCP_EMBED_OLLAMA_URL=http://localhost:11434
